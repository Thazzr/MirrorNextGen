# Kopie nach deploy/.env anlegen und bei Bedarf anpassen.
# docker compose liest die Datei automatisch (im Ordner deploy/ ausführen).

# Image-Tag: "latest" folgt main, eine Version wie "0.2.0" pinnt einen Stand.
MIRROR_TAG=latest

# Port, unter dem das Dashboard und die Verwaltung im LAN erreichbar sind.
MIRROR_PORT=8080

# Zeitzone für alle Container (IANA-Name).
TZ=Europe/Berlin

# --- Kiosk (Bildschirmanzeige am Pi) ---

# GPU-Beschleunigung von Chromium abschalten, falls das Bild flackert oder
# schwarz bleibt (true/false).
KIOSK_DISABLE_GPU=false

# Wer dreht das Bild: "compositor" (der Kiosk-Agent per wlr-randr, Standard)
# oder "browser" (das Dashboard dreht sich selbst; Ausweg, falls die
# Compositor-Drehung auf deinem Gerät nicht funktioniert).
KIOSK_ROTATION=compositor

# Mauszeiger anzeigen, z. B. zur Fehlersuche (true/false).
# KIOSK_SHOW_CURSOR=false

# Nur bei Bedarf, sonst auskommentiert lassen:
# Renderer des Compositors, z. B. "pixman" für reine Software-Darstellung.
# WLR_RENDERER=pixman
# Grafikgerät festlegen, falls der Bildschirm schwarz bleibt (card0 oder card1).
# WLR_DRM_DEVICES=/dev/dri/card1
